---
import Base from '../../layouts/Base.astro';
import PaperItem from '../../components/PaperItem.astro';
import { getCollection, render } from 'astro:content';
import { getPapers, getPeople } from '../../lib/data';

export async function getStaticPaths() {
  const tools = await getCollection('software');
  return tools.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}
const { tool } = Astro.props;
const { Content } = await render(tool);
const { labKeys } = await getPeople();
const paper = tool.data.paper
  ? (await getPapers()).find((p) => p.data.doi?.toLowerCase() === tool.data.paper!.toLowerCase())
  : undefined;
const linkLabel: Record<string, string> = { cran: 'CRAN', bioc: 'Bioconductor', github: 'GitHub', web: 'Web server', docs: 'Docs', pypi: 'PyPI' };
---
<Base title={tool.data.name} description={tool.data.tagline}>
  <div class="page">
    <div class="wrap">
      <a class="back" href="/#software">← Software</a>
      <h1 class="mono">{tool.data.name}</h1>
      <p class="muted" style="font-size:19px">{tool.data.tagline}</p>
      <div class="badges" style="margin:16px 0 28px">
        {Object.entries(tool.data.links).map(([k, v]) => <a class="badge" href={v}>{linkLabel[k] ?? k}</a>)}
      </div>
      <div class="prose"><Content /></div>
      {tool.data.image && <div class="figure"><img src={tool.data.image} alt={`${tool.data.name} overview`} /></div>}
      {tool.data.paper && (
        <>
          <div class="kicker" style="margin-top:32px">Please cite</div>
          {paper
            ? <ul class="pubs"><PaperItem paper={paper} labKeys={labKeys} compact /></ul>
            : <p><a href={`https://doi.org/${tool.data.paper}`}>doi:{tool.data.paper}</a></p>}
        </>
      )}
    </div>
  </div>
</Base>
