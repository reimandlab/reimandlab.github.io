---
import Base from '../layouts/Base.astro';
import PaperItem from '../components/PaperItem.astro';
import { site, getPeople, getPapers, themeLabel } from '../lib/data';

const { labKeys } = await getPeople();
const papers = await getPapers();
const years = [...new Set(papers.map((p) => p.data.year))].sort((a, b) => b - a);
const filters: [string, string][] = [
  ['all', 'All'], ['lab', 'Lab-led'], ['featured', 'Featured'], ['preprint', 'Preprints'],
  ...Object.entries(themeLabel).map(([k, v]) => [`theme:${k}`, v] as [string, string]),
];
---
<Base title="Publications" description={`Publications of the ${site.name}.`}>
  <div class="page">
    <div class="wrap">
      <a class="back" href="/#publications">← Home</a>
      <h1>Publications</h1>
      <p class="muted">
        Lab members in bold; ★ marks featured papers; collaborations are shown in lighter type.
        Also on <a href={site.links.scholar}>Google Scholar</a> and <a href={site.links.pubmed}>PubMed</a>.
      </p>

      <div class="filters" role="group" aria-label="Filter publications">
        {filters.map(([k, label], i) => <button type="button" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
        <input type="search" placeholder="Search title, author, journal…" aria-label="Search publications" />
        <span class="count" aria-live="polite">{papers.length} papers</span>
      </div>

      {years.map((y) => (
        <div class="year-group" data-year={y}>
          <h3>{y}</h3>
          <ul class="pubs">
            {papers.filter((p) => p.data.year === y).map((p) => <PaperItem paper={p} labKeys={labKeys} />)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
    const search = document.querySelector<HTMLInputElement>('.filters input')!;
    const count = document.querySelector('.count')!;
    let filter = 'all';

    function apply() {
      const q = search.value.trim().toLowerCase();
      let n = 0;
      document.querySelectorAll<HTMLElement>('.year-group').forEach((g) => {
        let visible = 0;
        g.querySelectorAll<HTMLElement>('.pub').forEach((li) => {
          const d = li.dataset;
          const ok =
            (filter === 'all' ||
              (filter === 'lab' && d.lab === '1') ||
              (filter === 'featured' && d.featured === '1') ||
              (filter === 'preprint' && d.preprint === '1') ||
              (filter.startsWith('theme:') && (d.themes ?? '').split(' ').includes(filter.slice(6)))) &&
            (!q || (d.text ?? '').includes(q));
          li.hidden = !ok;
          if (ok) visible++;
        });
        g.hidden = visible === 0;
        n += visible;
      });
      count.textContent = `${n} paper${n === 1 ? '' : 's'}`;
    }

    buttons.forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    search.addEventListener('input', apply);
  </script>
</Base>
