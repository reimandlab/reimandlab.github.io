---
import { fmtMonth, type NewsItem } from '../lib/data';
interface Props { items: NewsItem[] }
const { items } = Astro.props;
---
<ul class="news">
  {items.map((n) => (
    <li>
      <time datetime={n.date.toISOString().slice(0, 10)}>{fmtMonth(n.date)}</time>
      <span><span class:list={['tag', n.type]}>{n.type}</span>{n.href ? <a href={n.href}>{n.text}</a> : n.text}</span>
    </li>
  ))}
</ul>
