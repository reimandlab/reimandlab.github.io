---
import Authors from './Authors.astro';
import type { Paper } from '../lib/data';
interface Props { paper: Paper; labKeys: Set<string>; compact?: boolean }
const { paper, labKeys, compact = false } = Astro.props;
const d = paper.data;
---
<li
  class:list={['pub', { collab: !paper.labLed && !compact }]}
  data-lab={paper.labLed ? '1' : '0'}
  data-featured={d.featured ? '1' : '0'}
  data-preprint={d.type === 'preprint' ? '1' : '0'}
  data-themes={d.themes.join(' ')}
  data-text={`${d.title} ${d.authors.join(' ')} ${d.journal} ${d.year}`.toLowerCase()}
>
  {paper.href ? <a class="t" href={paper.href}>{d.title}</a> : <span class="t">{d.title}</span>}
  {d.featured && !compact && <span class="star" title="Featured">★</span>}
  <Authors authors={d.authors} labKeys={labKeys} max={compact ? 10 : 14} truncated={d.authors_truncated} />
  <div class="j">
    <i>{d.journal}</i> {d.year}
    <span class="links">
      {d.doi && <a href={`https://doi.org/${d.doi}`}>doi</a>}
      {d.pmid && <a href={`https://pubmed.ncbi.nlm.nih.gov/${d.pmid}/`}>pubmed</a>}
      {d.preprint && d.type !== 'preprint' && <a href={d.preprint}>preprint</a>}
      {d.code && <a href={d.code}>code</a>}
    </span>
  </div>
</li>
